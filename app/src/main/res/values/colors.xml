    <color name="lattice_fg">#E5E6E6</color>
    <color name="lattice_accent">#50D6FF</color>
    <color name="lattice_mid">#5F7A45</color>
    <!-- The window's own background, painted before Compose gets a frame up. -->
    <color name="ground">#FF141515</color>
</resources>
