<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. The pairing key never rides a backup or a device transfer:
     a restored phone re-pairs by QR. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="lattice_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="lattice_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
